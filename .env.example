# Local development only. Use separate random passwords elsewhere.
# Single quotes preserve literal $, # and spaces in Compose .env values.
# A literal single quote inside such a value is written as \'.
POSTGRES_PASSWORD='dev-owner-change-me'
APP_DB_PASSWORD='dev-app-change-me'

# Empty token and zero rate disable the optional protections locally.
API_TOKEN=
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=20

PG_MAX_CONNS=10
REQUEST_TIMEOUT=3s
QUERY_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
